# テンプレート。@PROJECT_DIR@ / @RUN_USER@ は install.sh が置換する。

[Unit]
Description=CBC2026 Team3 CAN バス初期化
Documentation=file://@PROJECT_DIR@/docs/operations.md
After=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=@PROJECT_DIR@/scripts/setup_can.sh --wait 15
ExecStop=/bin/true

[Install]
WantedBy=multi-user.target
