# テンプレート。@PROJECT_DIR@ / @RUN_USER@ は install.sh が置換する。

[Unit]
Description=CBC2026 Team3 中央制御プログラム (Web Controller 同梱)
Documentation=file://@PROJECT_DIR@/docs/operations.md
# man 5 systemd.unit: Requires= は依存先が明示的に stop / restart されると
# こちらへ伝播する。udev ルールは CANable が add されるたびに
# `systemctl restart cbc-can.service` を打つので、ここは Wants= でなければならない。
Wants=cbc-can.service
After=cbc-can.service network.target

# systemd v229 以降、この 2 つは [Service] に書くと黙って無視される。
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=@RUN_USER@
WorkingDirectory=@PROJECT_DIR@

ExecStartPre=/usr/bin/test -f @PROJECT_DIR@/web/dist/index.html

# mise の shim は systemd の PATH に無いので venv の実体を絶対パスで指す。
# -u: journal へ即時に流す (バッファに溜めたまま停止すると死因が残らない)。
ExecStart=@PROJECT_DIR@/.venv/bin/python -u main.py

Restart=on-failure
RestartSec=2

TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
