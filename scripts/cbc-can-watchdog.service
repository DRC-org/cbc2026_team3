# テンプレート。@PROJECT_DIR@ / @RUN_USER@ は install.sh が置換する。

[Unit]
Description=CBC2026 Team3 CAN bus-off 復旧ウォッチドッグ
Documentation=file://@PROJECT_DIR@/docs/operations.md
After=cbc-can.service
Requires=cbc-can.service

[Service]
Type=simple
ExecStart=@PROJECT_DIR@/scripts/can_watchdog.sh
Restart=always
RestartSec=5
# can_watchdog.sh は TERM で exit 143 する。手動 stop を failed 扱いにしない
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
